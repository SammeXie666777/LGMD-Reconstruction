objref all, somatic, axonal, basal, apical, dendritic_5, dendritic_6
objref dendritic_7
proc subsets() { local i
  objref all, somatic, axonal, basal, apical, dendritic_5, dendritic_6
  objref dendritic_7
  all = new SectionList()
    soma all.append()
    for i=0, 3 axon[i] all.append()
    for i=0, 232 dend[i] all.append()
    for i=0, 73 apic[i] all.append()
    dend_6 all.append()
    for i=0, 14 dend_7[i] all.append()
    for i=0, 37 dend_5[i] all.append()

  somatic = new SectionList()
    soma somatic.append()

  axonal = new SectionList()
    for i=0, 3 axon[i] axonal.append()

  basal = new SectionList()
    for i=0, 232 dend[i] basal.append()

  apical = new SectionList()
    for i=0, 73 apic[i] apical.append()

  dendritic_5 = new SectionList()
    for i=0, 37 dend_5[i] dendritic_5.append()

  dendritic_6 = new SectionList()
    dend_6 dendritic_6.append()

  dendritic_7 = new SectionList()
    for i=0, 14 dend_7[i] dendritic_7.append()

}
proc geom() {
}
proc geom_nseg() {
}
proc biophys() {
  forsec all {
    Ra = 35.4
    cm = 1
    insert pas
      g_pas = 0.001
      e_pas = -65
  }
}
access soma

celldef()
